{
  "name": "altana-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*",
    "docs"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "smoke": "bun run --filter '@altananetwork/e2e' smoke:all"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "devDependencies": {
    "@rollup/rollup-darwin-x64": "4.62.2",
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
