{
  "name": "@altananetwork/mcp",
  "version": "0.2.3",
  "description": "MCP server that lets AI hosts employ agents on Altana wallets",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altananetwork/sdk.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://docs.altana.network",
  "bugs": {
    "url": "https://github.com/altananetwork/sdk/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wallet",
    "agentic",
    "session-keys",
    "altana"
  ],
  "type": "module",
  "bin": {
    "altana-mcp": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-publishable.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@altananetwork/sdk": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/keyring": "^1.1.0",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
