{
  "name": "@altananetwork/hypersigner-keystore-mcp",
  "version": "0.2.0",
  "description": "Non-custodial MCP server for KeyStore agent authorization: verify, register, timebox, and revoke keys without signing.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/altananetwork/altana-sdk.git",
    "directory": "packages/hypersigner-keystore-mcp"
  },
  "homepage": "https://docs.altana.network",
  "bugs": {
    "url": "https://github.com/altananetwork/altana-sdk/issues"
  },
  "bin": {
    "hypersigner-keystore-mcp": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./keystore": "./src/keystore.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "keystore",
    "agent",
    "authorization",
    "agent-sdk",
    "bnb",
    "web3"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-publishable.mjs && bun run typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.5.0"
  }
}
