{
  "name": "@altananetwork/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end smoke and fork tests for @altananetwork/sdk and @altananetwork/mcp (BNB testnet, Celo Sepolia, anvil forks). Not published. Internal CI use.",
  "scripts": {
    "smoke:wallet": "bun run smoke-test.ts",
    "smoke:session": "bun run smoke-session.ts",
    "smoke:passkey": "bun run smoke-passkey.ts",
    "smoke:grant-first": "bun run smoke-grant-first.ts",
    "smoke:mcp": "bun run smoke-mcp.ts",
    "smoke:all": "bun run smoke-test.ts && bun run smoke-session.ts && bun run smoke-passkey.ts && bun run smoke-grant-first.ts && bun run smoke-mcp.ts",
    "fork:erc1271": "bun run fork-erc1271.ts",
    "fork:x402": "bun run fork-x402.ts",
    "fork:x402-witness": "bun run fork-x402-witness.ts",
    "fork:eip3009": "bun run fork-eip3009.ts",
    "fork:all": "bun run fork-erc1271.ts && bun run fork-x402.ts && bun run fork-x402-witness.ts && bun run fork-eip3009.ts && bun run fork-erc8004.ts && bun run fork-erc8183.ts && bun run fork-native-receive.ts && bun run fork-x402-server.ts && bun run fork-celo-cache.ts && bun run fork-celo-x402-server.ts",
    "fork:native-receive": "bun run fork-native-receive.ts",
    "demo:b402": "bun run demo-b402.ts",
    "typecheck": "tsc --noEmit",
    "fork:x402-server": "bun run fork-x402-server.ts",
    "fork:erc8183-buyer": "bun run fork-erc8183.ts",
    "fork:erc8004": "bun run fork-erc8004.ts",
    "demo:hire-studio-agent": "bun run demo-hire-studio-agent.ts",
    "live:erc8004-testnet": "bun run live-erc8004-testnet.ts",
    "live:holdings": "bun run live-holdings.ts",
    "fork:celo-cache": "bun run fork-celo-cache.ts",
    "fork:celo-x402-server": "bun run fork-celo-x402-server.ts",
    "smoke:celo-sepolia": "bun run smoke-celo-sepolia.ts",
    "smoke:celo-passkey": "bun run smoke-celo-passkey.ts"
  },
  "dependencies": {
    "@altananetwork/sdk": "workspace:*",
    "@altananetwork/mcp": "workspace:*",
    "porto": "0.2.37",
    "viem": "^2.21.0",
    "@altananetwork/x402-server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/bun": "^1.1.0",
    "@types/node": "^20.17.0"
  }
}
