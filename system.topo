// Sdk — system map. Authored by hand; Topo does not generate this file.
//
// Altana agentic-wallet SDK: EIP-7702 smart-account wallets operated through
// the Porto relay, authorized by the on-chain KeyStore registry. AI agents
// reach the wallet through two MCP servers; humans reach it through the demo
// apps and the docs playground.

// ---------- Things — the data that flows ------------------------------------

thing Wallet   { address: id }
thing Call     { to: id  value: money  data: text }
thing Receipt  { callsId: id  transactionHash: id  status: text }
thing Balance  { native: money }

thing Signer   { type: text  address: id  publicKey: text }
thing Passkey  { kind: text  credentialId: id  publicKey: text  rpId: text }

thing CallPermission  { signature: text  to: id }
thing SpendPermission { limit: money  period: text  token: id }
thing Permissions     { calls: [CallPermission]  spend: [SpendPermission] }
thing Session  { walletAddress: id  signer: Signer  publicKey: text  permissions: Permissions  expiry: time }

thing NetworkConfig { chainId: int  keyStore: id  keyStoreController: id  publicRpcUrl: text  relayUrl: text }
thing CallBundle    { wallet: id  chainId: int  calls: [Call]  keyType: text  signature: text }
thing Transaction   { hash: id  chainId: int }
thing KeyRecord     { validator: id  publicKey: text  metadata: text  nonce: int  lastUpdated: time  revoked: bool  expiry: time  isRoot: bool }
thing StorageProof  { blockNumber: int  accountProof: [text]  storageProof: [text] }

thing ToolCall      { tool: text  arguments: text }
thing ToolResult    { content: text  isError: bool }
thing Calldata      { to: id  value: money  data: text  chainId: int }
thing WalletKey     { name: text  address: id  privateKey: text  source: text }
thing SessionRecord { name: text  walletName: text  walletAddress: id  permissions: Permissions  expiry: time  createdAt: time }

world Sdk {

  // ---------- Gateways — the world outside ----------------------------------

  gateway Agent      { out ToolCall  in ToolResult  in Calldata  out Transaction }
  gateway EndUser    { out Passkey  in Wallet }
  gateway PortoRelay { in CallBundle  out Receipt  out Transaction }
  gateway Chain      { in Transaction  out KeyRecord  in StorageProof  out StorageProof }

  // ---------- The core SDK ---------------------------------------------------

  system WalletSdk {
    code "packages/wallet/**"
    code "tests/e2e/**"   // e2e smoke tests exercise the SDK end to end

    in Call  in Passkey  in Signer  in Permissions  in Receipt  in KeyRecord  in StorageProof
    out Wallet  out Session  out Receipt  out CallBundle  out StorageProof  out Balance

    storage Networks {
      code "packages/wallet/src/config.ts"
      holds NetworkConfig
    }

    activity Signing {
      code "packages/wallet/src/internal/signer.ts"
      code "packages/wallet/src/internal/passkey.ts"
      in Passkey  out Signer
    }

    activity Lifecycle {
      code "packages/wallet/src/createWallet.ts"
      code "packages/wallet/src/createPasskeyWallet.ts"
      code "packages/wallet/src/recoverFromPasskey.ts"
      in Signer  in KeyRecord  out Wallet
    }

    activity Sessions {
      code "packages/wallet/src/grantSession.ts"
      code "packages/wallet/src/revokeSession.ts"
      code "packages/wallet/src/internal/sessions.ts"
      in Permissions  in Signer  in Calldata  out Session
    }

    activity Execution {
      code "packages/wallet/src/execute.ts"
      code "packages/wallet/src/balances.ts"
      in Call  in Session  in Wallet  in Receipt  out Call  out Receipt  out Balance
    }

    activity Relaying {
      code "packages/wallet/src/internal/relay.ts"
      in NetworkConfig  in Call  in Receipt  out CallBundle  out Receipt
    }

    activity KeystoreCodec {
      code "packages/wallet/src/internal/keystore.ts"
      in KeyRecord  out Calldata  out KeyRecord
    }

    activity KeySync {
      code "packages/wallet/src/syncKeyToL2.ts"
      in StorageProof  out StorageProof
    }

    Networks      --( NetworkConfig )--> Relaying
    Signing       --( Signer )-->        Lifecycle
    Signing       --( Signer )-->        Sessions
    Lifecycle     --( Wallet )-->        Execution
    Sessions      --( Session )-->       Execution
    Execution     --( Call )-->          Relaying
    Relaying      --( Receipt )-->       Execution
    KeystoreCodec --( Calldata )-->      Sessions
    KeystoreCodec --( KeyRecord )-->     Lifecycle
  }

  // ---------- MCP servers for AI hosts ---------------------------------------

  system WalletMcp {
    code "packages/mcp/**"
    code "tests/e2e/smoke-mcp.ts"
    in ToolCall  out ToolResult  out Permissions  in Session  out Call  in Receipt

    activity WalletTools {
      code "packages/mcp/src/index.ts"
      in ToolCall  out ToolResult  in WalletKey  in SessionRecord  out SessionRecord
      out Permissions  in Session  out Call  in Receipt
    }

    storage KeyVault {
      code "packages/mcp/src/keys.ts"
      holds WalletKey
    }

    storage SessionLedger {
      code "packages/mcp/src/sessions.ts"
      holds SessionRecord
    }

    KeyVault      --( WalletKey )-->     WalletTools
    WalletTools   --( SessionRecord )--> SessionLedger
    SessionLedger --( SessionRecord )--> WalletTools
  }

  system KeystoreMcp {
    code "packages/hypersigner-keystore-mcp/**"
    in ToolCall  out ToolResult  out Calldata  in KeyRecord

    activity RegistryTools {
      code "packages/hypersigner-keystore-mcp/src/index.ts"
      in ToolCall  in Calldata  in KeyRecord  out ToolResult  out Calldata
    }

    activity RegistryCodec {
      code "packages/hypersigner-keystore-mcp/src/keystore.ts"
      in KeyRecord  out KeyRecord  out Calldata
    }

    RegistryCodec --( Calldata )-->  RegistryTools
    RegistryCodec --( KeyRecord )--> RegistryTools
  }

  // ---------- Human-facing surfaces ------------------------------------------

  system Demos {
    code "apps/**"
    out Call  in Wallet

    activity PasskeyDemo {
      code "apps/passkey-demo/**"
      out Call  in Wallet
    }

    activity CrosschainDemo {
      code "apps/passkey-crosschain/**"
      out Call  in Wallet
    }
  }

  activity Docs {
    code "docs/**"
    out Call  in Wallet
  }

  // ---------- World-level flows ----------------------------------------------

  // Agents operate wallets through the MCP servers.
  Agent         --( ToolCall )-->   WalletTools
  WalletTools   --( ToolResult )--> Agent
  Agent         --( ToolCall )-->   RegistryTools
  RegistryTools --( ToolResult )--> Agent
  RegistryTools --( Calldata )-->   Agent   // host signs & submits itself — non-custodial
  Agent         --( Transaction )--> Chain

  // The wallet MCP drives the SDK with keychain-resolved signers.
  WalletTools --( Permissions )--> Sessions
  Sessions    --( Session )-->     WalletTools
  WalletTools --( Call )-->        Execution
  Execution   --( Receipt )-->     WalletTools

  // Humans drive the SDK through the demos and docs playground.
  EndUser        --( Passkey )--> Signing
  PasskeyDemo    --( Call )-->    Execution
  CrosschainDemo --( Call )-->    Execution
  Docs           --( Call )-->    Execution
  Execution      --( Wallet )-->  PasskeyDemo
  Execution      --( Wallet )-->  CrosschainDemo
  Execution      --( Wallet )-->  Docs

  // The SDK reaches the chain through the Porto relay; reads go direct.
  Relaying   --( CallBundle )-->   PortoRelay
  PortoRelay --( Receipt )-->      Relaying
  PortoRelay --( Transaction )-->  Chain
  Chain      --( KeyRecord )-->    KeystoreCodec
  Chain      --( KeyRecord )-->    RegistryCodec
  Chain      --( StorageProof )--> KeySync
  KeySync    --( StorageProof )--> Chain
}
