{
  "world": "Sdk",
  "map": "system.topo",
  "lock": "system.topo.lock",
  "include": [
    "**/*.{ts,tsx,js,jsx,mjs,cjs,py,go,rs,rb,java,kt,kts,php,cs,swift,scala,c,cc,cpp,h,hh,hpp,m,mm,vue,svelte,sql,sh}"
  ],
  "ignore": [
    "dist/**",
    "build/**",
    "**/*.min.*",
    "scripts/**"
  ],
  "viewer": {
    "port": 4517
  },
  "check": {
    "strict": false
  },
  "policy": {
    "coverage": "strict",
    "approval": "agent",
    "onRegionChange": "block"
  }
}
